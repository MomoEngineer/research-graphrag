# Beispiel-Umgebungsvariablen für research-graphrag.
# Kopiere diese Datei nach `.env` und passe die Werte an. `.env` wird NICHT committet.
#
# WICHTIG (Secrets-Policy, siehe docs/documentation-standards.md, Abschnitt 8):
# Keine Tokens/Passwörter/API-Keys in Code, mcp.json oder committeten Dateien.
# Die Standard-Generierung läuft secret-frei über die LLM-Bridge (MCP-Sampling vom
# Copilot-Client, siehe docs/adr/0004-llm-bridge-via-mcp-sampling.md).

# --- Workspace-Grenze (Datei-Zugriff des künftigen MCP-Servers, Phase 5) ---
# os.pathsep-getrennte Liste erlaubter Roots. Leer => Zugriff wird verweigert.
RESEARCH_GRAPHRAG_WORKSPACE_ROOTS=

# --- Logging ---
# Standardniveau des Server-Logs (stderr). Einer von: DEBUG, INFO, WARNING, ERROR.
RESEARCH_GRAPHRAG_LOG_LEVEL=INFO

# =====================================================================
# OFFEN (Phase 2/3): Index-Backend für den GraphRAG-Bau.
#
# Der Index-Bau (Extraktion, Community-Reports, Embeddings) ist ein Batch-Lauf
# OHNE MCP-Client und wird daher NICHT von der LLM-Bridge abgedeckt; MCP-Sampling
# liefert zudem keine Embeddings. Ob dafür ein lokales Modell (z. B. Ollama), ein
# Cloud-API-Zugang oder ein Offline-Hybrid (deterministische Extraktion + TF-IDF)
# genutzt wird, ist noch offen (siehe docs/adr/0005-graphrag-index-backend-open.md).
# Erst nach dieser Entscheidung werden hier die konkreten Variablen ergänzt.
# =====================================================================
